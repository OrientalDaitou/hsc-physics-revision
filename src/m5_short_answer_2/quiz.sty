% "M5T3 Motion in Gravitational Fields" quiz: A4, black and white, centred bold
% Calibri title, "Question N – (source)" headings in Calibri bold, question text
% and options in Times New Roman (HSC paper style), page number bottom right.
% XeLaTeX only. Used by quiz.tex and quiz_answers.tex.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{quiz}

\RequirePackage[a4paper, left=2.4cm, right=2.4cm, top=2.3cm, bottom=2.6cm,
  footskip=1.3cm]{geometry}
\RequirePackage{amsmath}
\RequirePackage{fontspec}
\RequirePackage{unicode-math}
\setmainfont{Times New Roman}
\setmathfont{STIX Two Math}
\IfFontExistsTF{Calibri}{\newfontfamily\headfont{Calibri}}{%
  \IfFileExists{/Applications/Microsoft Word.app/Contents/Resources/DFonts/Calibri.ttf}{%
    \newfontfamily\headfont{Calibri}[Path=/Applications/Microsoft Word.app/Contents/Resources/DFonts/,
      Extension=.ttf, UprightFont=*, BoldFont=*b, ItalicFont=*i, BoldItalicFont=*z]}{%
    \newfontfamily\headfont{Carlito}}}  % Carlito = free font with Calibri's shapes
\linespread{1.08}
\setlength\parindent{0pt}
\hyphenpenalty=10000 \exhyphenpenalty=10000 \emergencystretch=3em
\setlength\parskip{6pt}
\RequirePackage{needspace}
\RequirePackage{array}
\RequirePackage{xcolor}
\RequirePackage{siunitx}
\sisetup{exponent-product=\times, per-mode=power, inter-unit-product=\,,
  group-separator={\,}, group-minimum-digits=5, separate-uncertainty=true}
\DeclareSIUnit\yr{yr}
\RequirePackage{tikz}
\usetikzlibrary{arrows.meta, calc, shadings, patterns}
\RequirePackage{pgfplots}
\pgfplotsset{compat=1.18}
\RequirePackage{enumitem}
\setlist[itemize]{topsep=2pt, itemsep=2pt, parsep=0pt, leftmargin=1.6em}
\RequirePackage{fancyhdr}
\pagestyle{fancy}
\fancyhf{}
\fancyfoot[R]{{\headfont\fontsize{11}{13}\selectfont\thepage}}
\renewcommand\headrulewidth{0pt}
\fancypagestyle{plain}{\fancyhf{}\fancyfoot[R]{{\headfont\fontsize{11}{13}\selectfont\thepage}}%
  \renewcommand\headrulewidth{0pt}}
\RequirePackage[hidelinks]{hyperref}

% ---- black-and-white drawing styles (same names as the revision books)
\colorlet{hscink}{black}\colorlet{hscmuted}{black}\colorlet{hscrule}{black!45}
\colorlet{hscseriesA}{black}\colorlet{hscseriesB}{black}
\colorlet{hscacc}{black!45}\colorlet{hscbrand}{black!60}\colorlet{hscforce}{black}
\tikzset{
  >={Stealth[length=2.4mm, width=1.8mm]},
  every picture/.append style={line cap=round, line join=round},
  force/.style       ={->, line width=0.9pt, color=black},
  displacement/.style={->, line width=0.7pt, color=black},
  guide/.style       ={line width=0.5pt, dash pattern=on 2pt off 2pt, color=black!70},
  axisline/.style    ={->, line width=0.7pt, color=black},
  object/.style      ={draw=black, fill=white, line width=0.7pt},
}

% ---- title:  \quiztitle{line 1}{line 2}
\newcommand\quiztitle[2]{%
  \begin{center}
    {\headfont\bfseries\fontsize{16}{21}\selectfont #1\\ #2\par}
  \end{center}\vspace{2pt}}

% ---- one question:  \begin{quizq}{} ... \end{quizq}
\newcounter{qn}
\NewDocumentEnvironment{quizq}{m}{%
  \par\refstepcounter{qn}%
  \hypertarget{q.\arabic{qn}}{}%
  \noindent{\headfont\bfseries\fontsize{11}{14}\selectfont
    \hyperlink{a.\arabic{qn}}{Question \arabic{qn}}}\par\nobreak
  \vspace{2pt}}{\par\vspace{9mm}}

% ---- options, one per line:  \opts{..}{..}{..}{..}
\newcommand\optline[2]{\par\noindent\hangindent=12mm\hangafter=1
  \makebox[12mm][l]{#1}#2\par\vspace{3pt}}
\newcommand\opts[4]{\par\vspace{2pt}%
  \optline{A.}{#1}\optline{B.}{#2}\optline{C.}{#3}\optline{D.}{#4}}
% ---- options that are pictures, 2 x 2:  \gridopts{..}{..}{..}{..}
\newcommand\gridcell[2]{\begin{minipage}[t]{0.48\linewidth}%
  \makebox[10mm][l]{#1}\begin{minipage}[t]{\dimexpr\linewidth-12mm\relax}\vspace{0pt}#2%
  \end{minipage}\end{minipage}}
\newcommand\gridopts[4]{\par\vspace{4pt}\noindent
  \gridcell{A.}{#1}\hfill\gridcell{B.}{#2}\par\vspace{8mm}\noindent
  \gridcell{C.}{#3}\hfill\gridcell{D.}{#4}\par}

% ---- topic heading (centred, like the title), starts a new page:  \topictitle{...}
\newcommand\topictitle[1]{\clearpage
  \begin{center}{\headfont\bfseries\fontsize{14}{18}\selectfont #1\par}\end{center}\vspace{2pt}}
\newcommand\firsttopictitle[1]{%
  \begin{center}{\headfont\bfseries\fontsize{14}{18}\selectfont #1\par}\end{center}\vspace{2pt}}

% ---- options that are PAIRS of graphs (one row each):  \pairopts{A1}{A2}{B1}{B2}{C1}{C2}{D1}{D2}
\newcommand\pairrow[3]{\par\noindent\makebox[12mm][l]{#1}%
  \begin{minipage}[t]{0.38\linewidth}\vspace{0pt}#2\end{minipage}\hspace{8mm}%
  \begin{minipage}[t]{0.38\linewidth}\vspace{0pt}#3\end{minipage}\par\vspace{4mm}}
\newcommand\pairopts[8]{\par\vspace{3pt}%
  \pairrow{A.}{#1}{#2}\pairrow{B.}{#3}{#4}\pairrow{C.}{#5}{#6}\pairrow{D.}{#7}{#8}}

% ---- small graph axes (use inside a tikzpicture)
%   \gaxesP{y label}{x label}   y >= 0 only
%   \gaxesPN{y label}{x label}  y above and below zero, with "0"
\newcommand\gaxesP[2]{\draw[axisline] (0,0) -- (2.8,0) node[right, font=\small] {#2};
  \draw[axisline] (0,0) -- (0,1.8) node[above, font=\small] {#1};}
\newcommand\gaxesPN[2]{\draw[axisline] (0,0) -- (2.8,0) node[right, font=\small] {#2};
  \draw[axisline] (0,-1.3) -- (0,1.5) node[above, font=\small] {#1};
  \node[left, font=\footnotesize] at (0,0) {0};}

% ---- small arrows for tables:  \ra  \ua  \da
\newcommand\ra{\tikz[baseline=-0.6ex]\draw[->, line width=0.6pt] (0,0) -- (0.5,0);}
\newcommand\ua{\tikz[baseline=-0.6ex]\draw[->, line width=0.6pt] (0,-0.22) -- (0,0.28);}
\newcommand\da{\tikz[baseline=-0.6ex]\draw[->, line width=0.6pt] (0,0.28) -- (0,-0.22);}

% ---- answers file
\newcounter{an}
\NewDocumentEnvironment{practiceanswers}{o}{}{}
\NewDocumentEnvironment{practiceans}{}{\par\refstepcounter{an}}{\par\vspace{5mm}}
\newcommand\correct[1]{%
  \hypertarget{a.\arabic{an}}{}%
  \noindent{\headfont\bfseries\fontsize{11}{14}\selectfont
    \hyperlink{q.\arabic{an}}{Question \arabic{an} – Answer: #1}}\par\nobreak\vspace{1pt}}
\newcommand\xmark{{\bfseries\texttimes}}

% =====================================================================
% Short-answer additions (HSC Section II style)
% =====================================================================
\makeatletter
% \begin{saq}{5} ... \end{saq}  -> "Question N (5 marks)"
\newcounter{saqn}
\NewDocumentEnvironment{saq}{m}{%
  \par\refstepcounter{saqn}%
  \hypertarget{q.\arabic{saqn}}{}%
  \noindent{\headfont\bfseries\fontsize{11}{14}\selectfont
    \hyperlink{a.\arabic{saqn}}{Question \arabic{saqn}} (#1~\ifnum#1=1 mark\else marks\fi)}%
  \par\nobreak\vspace{2pt}}{\par\vspace{8mm}}
% \qpart{a}{2}{text}: part label on the left, marks on the right (as in HSC papers)
\newcommand\qpart@body[3]{\noindent
  \makebox[10mm][l]{(#1)}%
  \parbox[t]{\dimexpr\linewidth-20mm\relax}{\setlength\parskip{5pt}#3}%
  \hfill\makebox[8mm][r]{#2}\par\vspace{2pt}}
\newcommand\qpart[3]{\par\vspace{3pt}\qpart@body{#1}{#2}{#3}}
% \alines{n}: n dotted answer lines across the page (kept together on one page)
\newcommand\alines@body[1]{\begingroup\setlength\parskip{0pt}%
  \@tempcnta=#1\relax
  \loop\ifnum\@tempcnta>0
    \vspace{8.5mm}\noindent\textcolor{black!45}{\leavevmode\xleaders\hbox to 1.6mm{\hss.\hss}\hskip\linewidth}\par
    \advance\@tempcnta\m@ne
  \repeat\endgroup}
\newcommand\alines[1]{\par\noindent\begin{minipage}{\linewidth}\alines@body{#1}\end{minipage}\par\vspace{2mm}}
% \qpartL{a}{2}{text}{n}: a part and its n answer lines, never split across pages
\newcommand\qpartL[4]{\par\vspace{3pt}\noindent\begin{minipage}{\linewidth}\setlength\parskip{6pt}%
  \qpart@body{#1}{#2}{#3}\alines@body{#4}\end{minipage}\par\vspace{2mm}}
% answers: \begin{crit} \critrow{text}{2} ... \end{crit}   (NESA marking-guideline table)
\newenvironment{crit}{\par\vspace{2pt}\noindent\renewcommand\arraystretch{1.35}%
  \begin{tabular}{|p{\dimexpr\linewidth-30mm\relax}|>{\centering\arraybackslash}p{16mm}|}\hline
  \textbf{Criteria} & \textbf{Marks}\\\hline}{\end{tabular}\par\vspace{4pt}}
\newcommand\critrow[2]{#1 & #2\\\hline}
\newcommand\sample{\par\Needspace{4\baselineskip}\noindent\textit{\textbf{Sample answer:}}\par\nobreak}
% answer heading:  \anshead{2}{(a)} or for whole question \anshead{}{}
\newcounter{ansq}
\newcommand\ansq{\par\Needspace{8\baselineskip}\vspace{4mm}\refstepcounter{ansq}%
  \hypertarget{a.\arabic{ansq}}{}%
  \noindent{\headfont\bfseries\fontsize{11}{14}\selectfont
    \hyperlink{q.\arabic{ansq}}{Question \arabic{ansq}}}\par\nobreak\vspace{1pt}}
\newcommand\anspart[1]{\par\Needspace{6\baselineskip}\vspace{2pt}\noindent\textbf{Part (#1)}\par\nobreak}
\makeatother
\endinput
