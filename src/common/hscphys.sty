%% ===================================================================
%% 4. Spacing, paragraphs, line breaking
%% ===================================================================
\RequirePackage{setspace}
\setstretch{1.25}
\setlength{\parindent}{0pt}
\setlength{\parskip}{7pt plus 2pt minus 1pt}
\RequirePackage{ragged2e}
\setlength{\RaggedRightRightskip}{0pt plus 1fil}
\AtBeginDocument{\RaggedRight\color{hscink}}
% no hyphenation in running text (easier for second-language readers)
\hyphenpenalty=10000
\exhyphenpenalty=50
\widowpenalty=10000
\clubpenalty=10000
\displaywidowpenalty=10000
\raggedbottom
\RequirePackage{needspace}
\setlength{\emergencystretch}{1.5em}

%% Lists
\RequirePackage{enumitem}
\setlist{topsep=3pt, partopsep=0pt, itemsep=2pt, parsep=1pt, leftmargin=1.6em}
