\pgfplotsset{
  hsc/.style={
    width=0.78\linewidth, height=0.5\linewidth,
    axis lines=left, axis line style={hscink!75, line width=0.6pt},
    tick style={hscink!75}, major tick length=3pt, tick align=outside,
    grid=major, grid style={hscrule!70, line width=0.3pt},
    tick label style={font=\small}, label style={font=\small},
    every axis plot/.append style={line width=1pt},
    cycle list name=hsc,
    legend style={draw=none, fill=white, fill opacity=0.85, text opacity=1,
