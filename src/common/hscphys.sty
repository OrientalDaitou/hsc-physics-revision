\newcommand\hsc@pill[3]{% bg, text colour, content
  \tcbox[on line, enhanced, colback=#1, colframe=#1, boxrule=0pt, arc=5pt,
    left=5pt, right=5pt, top=1.6pt, bottom=1.6pt, boxsep=0pt,
    fontupper=\footnotesize\bfseries\color{#2}]{#3}}
\newcommand\hscbadgeonsheet{\hsc@pill{hscformula!12}{hscformula!80!black}%
  {\faCheckCircle\hspace{0.45em}On the formula sheet}}
\newcommand\hscbadgenotonsheet{\hsc@pill{hscmistake}{white}%
  {\faExclamationTriangle\hspace{0.45em}Not on the formula sheet – learn it or derive it}}
\newcommand\hscbadgecombine[1]{%
  \tcbox[enhanced, colback=hsctip!22!white, colframe=hsctip!22!white, boxrule=0pt,
    arc=5pt, left=6pt, right=6pt, top=1.6pt, bottom=1.6pt, boxsep=0pt,
    halign=center, nobeforeafter, tcbox width=auto limited,
    fontupper=\footnotesize\bfseries\color{hsctiptext}]%
  {\faLink\hspace{0.45em}Not printed in this form – combine #1 (on the sheet)}}
\newcommand\hsc@sheetbadge{%
  \ifhsc@combine\expandafter\hscbadgecombine\expandafter{\hsc@combinetext}%
  \else\ifhsc@onsheet\hscbadgeonsheet\else\hscbadgenotonsheet\fi\fi}

\newif\ifhsc@fchasformula
\newtcolorbox{hsc@fcbox}[2][]{hsc major=hscformula,
  title={\hsc@titlebar{\faIcon{square-root-alt}}{Formula card}{#2}},
  title after break={\hsc@titlebar{\faIcon{square-root-alt}}{Formula card}{#2}\hsc@cont},
  before upper={\hsc@boxsetup\hsc@infctrue\global\hsc@fchasformulafalse},
  after upper={\ifhsc@fchasformula\else\PackageWarning{hscphys}{formulacard
    `#2' has no \string\cardformula}\fi}, #1}
\NewDocumentEnvironment{formulacard}{O{} m}{\hsc@parseopts{#1}\hsc@needspace{10}%
  \expandafter\hsc@fcbegin\expandafter{\hsc@tcbopts}{#2}}{\endhsc@fcbox}
\def\hsc@fcbegin#1#2{\hsc@fcbox[#1]{#2}}

% the displayed formula (with the formula-sheet badge under it)
\newcommand\cardformula[1]{%
  \global\hsc@fchasformulatrue
  \par\addvspace{1pt}%
  \begin{tcolorbox}[enhanced, colback=white, colframe=hscformula!28, boxrule=0.6pt,
      arc=2pt, top=2.4mm, bottom=1.8mm, left=2mm, right=2mm,
      boxsep=0pt, before skip=0pt, after skip=3pt]
    {\Large\centering$\displaystyle #1$\par}%
    \vspace{4pt}{\centering\hsc@sheetbadge\par}
  \end{tcolorbox}}

% symbol table:  \begin{symbols} \sym{$v$}{speed}{\si{m.s^{-1}}} ... \end{symbols}
\newenvironment{symbols}{%
  \par\addvspace{2pt}\noindent
  \arrayrulecolor{hscformula!25}\renewcommand\arraystretch{1.25}%
  \begin{tabular}{@{}C{15mm}@{\hspace{3mm}}L{\dimexpr\linewidth-15mm-30mm-6mm\relax}%
      @{\hspace{3mm}}L{30mm}@{}}
  \textcolor{hscformula!80!black}{\footnotesize\bfseries Symbol} &
  \textcolor{hscformula!80!black}{\footnotesize\bfseries Meaning} &
  \textcolor{hscformula!80!black}{\footnotesize\bfseries SI unit}\\\hline}{%
  \end{tabular}\par\addvspace{2pt}}
\newcommand\sym[3]{#1 & #2 & #3\\\hline}

% labelled lines inside a formula card
\newcommand\hsc@field[4][hscformula!82!black]{%
  \par\addvspace{2pt}%
  \leavevmode{\color{#1}\bfseries #2\hspace{0.4em}#3:}\hspace{0.45em}#4\par}
\newcommand\inwords[1]{\hsc@field{\faCommentDots}{In words}{#1}}
\newcommand\whentouse[1]{\hsc@field{\faCheckCircle}{When to use}{#1}}
\newcommand\whennottouse[1]{\hsc@field{\faTimesCircle}{When NOT to use}{#1}}
\newcommand\rearranged[1]{\hsc@field{\faIcon{exchange-alt}}{Rearranged}{#1}}
\newcommand\tensecond[1]{\hsc@field{\faIcon{stopwatch}}{10-second example}{#1}}
\newcommand\trap[1]{\hsc@field[hscmistake]{\faExclamationTriangle}{Trap}{#1}}
\newcommand\derive[1]{\hsc@field{\faPuzzlePiece}{Where it comes from}{#1}}

