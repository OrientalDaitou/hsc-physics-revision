\providecommand\modulenumber{0}
\providecommand\moduletitle{Module title}

%% ===================================================================
%% 11. Text helpers
%% ===================================================================
% \term{word}: bold first use of a technical term
\newcommand\term[1]{{\bfseries\color{hscbrand}#1}}
% tick and cross
\newcommand\cmark{\textcolor{hscexample}{\faCheck}}
\newcommand\xmark{\textcolor{hscmistake}{\faTimes}}
% several lines of maths that start on the current line (use inside steps)
\newcommand\eqlines[1]{$\begin{aligned}[t]#1\end{aligned}$}

% syllabus coverage tag: \covers{M5.IQ2.01} or \covers{M5.IQ2.01, M5.IQ2.02}
% Writes "<ID> <page> <chapter> <section>" lines to <jobname>.cov (no visible output).
\newwrite\hsc@covfile
\newif\ifhsc@covopen
\newif\ifhsc@showcoverage
\newcommand\hscshowcoverage{\hsc@showcoveragetrue}
\def\hsc@nospace#1{\zap@space#1 \@empty}
\newcommand\covers[1]{%
  \ifhsc@covopen\else
    \immediate\openout\hsc@covfile=\jobname.cov\relax
    \global\hsc@covopentrue
  \fi
  \@for\hsc@cov:=#1\do{%
    \edef\hsc@cov{\expandafter\hsc@nospace\expandafter{\hsc@cov}}%
    \edef\hsc@tmp{\noexpand\write\noexpand\hsc@covfile{\hsc@cov\space
      page=\noexpand\thepage\space chapter=\arabic{chapter}\space
      section=\ifnum\value{section}>0 \thesection\else -\fi}}%
    \hsc@tmp}%
  \ifhsc@showcoverage\marginpar{\RaggedRight\tiny\color{hscmuted}#1}\fi
  \ignorespaces}

%% ===================================================================
%% 12. Box system
%% ===================================================================
% ---- option parser: our own keys + any tcolorbox key
\newif\ifhsc@nonumber
\newif\ifhsc@onsheet
\newif\ifhsc@combine
\newif\ifhsc@infc
\newif\ifhsc@divider
\def\hsc@tcbopts{}
\def\hsc@combinetext{}
\pgfkeys{/hsc/opts/.is family}
\pgfkeys{/hsc/opts/.cd,
  nonumber/.code   = {\hsc@nonumbertrue},
  onsheet/.code    = {\hsc@onsheettrue\hsc@combinefalse},
  notonsheet/.code = {\hsc@onsheetfalse\hsc@combinefalse},
  combine/.code    = {\hsc@onsheetfalse\hsc@combinetrue\def\hsc@combinetext{#1}},
  .unknown/.code   = {%
    \def\hsc@val{#1}%
    \ifx\hsc@val\pgfkeysnovalue@text
      \eappto\hsc@tcbopts{\pgfkeyscurrentname,}%
    \else
      \eappto\hsc@tcbopts{\pgfkeyscurrentname={\unexpanded{#1}},}%
    \fi}}
\newcommand\hsc@parseopts[1]{%
  \hsc@nonumberfalse\hsc@onsheettrue\hsc@combinefalse\def\hsc@tcbopts{}%
  \pgfkeys{/hsc/opts/.cd,#1}}

% ---- keep space for the start of a box (but not straight after a heading)
\newcommand\hsc@needspace[1]{\par\if@nobreak\else\Needspace{#1\baselineskip}\fi}

% ---- what every box does at the start of its body
\newcommand\hsc@boxsetup{\RaggedRight\setlength{\parskip}{5pt plus 1pt}%
  \setlength{\parindent}{0pt}\hyphenpenalty=10000\relax}

% ---- title bar text:  icon  LABEL  Name
\newcommand\hsc@titlebar[3]{%
  \mbox{#1}\hspace{0.6em}%
  {\footnotesize\hsc@semibold\addfontfeatures{LetterSpace=9}\MakeUppercase{#2}}%
  \if\relax\detokenize{#3}\relax\else\hspace{0.8em}{\bfseries #3}\fi}
% public version, for hand-made boxes:  title={\hscboxtitle{\faFlask}{Label}{Name}}
\newcommand\hscboxtitle{\hsc@titlebar}
\newcommand\hsc@cont{\hspace{0.5em}{\footnotesize\mdseries\itshape(continued)}}

\tcbset{
  hsc base/.style={enhanced, breakable,
    before skip=11pt plus 2pt, after skip=6pt plus 2pt,
    left=4mm, right=4mm, top=2.4mm, bottom=2.6mm, boxsep=0pt,
    lefttitle=4mm, righttitle=4mm, toptitle=1.5mm, bottomtitle=1.5mm,
    fonttitle=\normalfont\bfseries, before upper=\hsc@boxsetup,
    pad at break*=1.5mm},
  hsc major/.style={hsc base, colframe=#1, colback=#1!4!white,
    colbacktitle=#1, coltitle=white, boxrule=0.7pt, arc=2.5pt, titlerule=0pt},
  hsc minor/.style={hsc base, sharp corners, boxrule=0pt, leftrule=3.2pt,
    colframe=#1, colback=#1!5!white, colbacktitle=#1!13!white,
    coltitle=#1!78!black, titlerule=0pt},
}

%% ---------------------------------------------------------------
%% 12a. The big idea / Key words / Common mistakes / HSC exam tip /
%%      Maths toolkit / Quick refresher
%% ---------------------------------------------------------------
\newtcolorbox{hsc@bigideabox}[1][]{hsc minor=hscbigidea, unbreakable,
  title={\hsc@titlebar{\faLightbulb}{The big idea}{}},
  title after break={\hsc@titlebar{\faLightbulb}{The big idea}{}\hsc@cont},
  fontupper=\large, #1}
\NewDocumentEnvironment{bigidea}{O{}}{\hsc@parseopts{#1}\hsc@needspace{3}%
  \expandafter\hsc@bigideabox\expandafter[\hsc@tcbopts]}{\endhsc@bigideabox}

\newtcolorbox{hsc@kwbox}[1][]{hsc minor=hsckw, unbreakable,
  title={\hsc@titlebar{\faKey}{Key words}{}},
  title after break={\hsc@titlebar{\faKey}{Key words}{}\hsc@cont},
  before upper={\hsc@boxsetup\setlength{\parskip}{3pt plus 1pt}}, #1}
\NewDocumentEnvironment{keywords}{O{}}{\hsc@parseopts{#1}\hsc@needspace{3}%
  \expandafter\hsc@kwbox\expandafter[\hsc@tcbopts]}{\endhsc@kwbox}
% \kw{Term}{plain meaning}
\newcommand\kw[2]{\par\noindent\hangindent=1.2em\hangafter=1
  {\bfseries\color{hsckw!80!black}#1}\enspace\textcolor{hsckw!60}{\textendash}\enspace #2\par}

\newtcolorbox{hsc@mistakebox}[1][]{hsc minor=hscmistake, unbreakable,
  title={\hsc@titlebar{\faExclamationTriangle}{Common mistakes}{}},
  title after break={\hsc@titlebar{\faExclamationTriangle}{Common mistakes}{}\hsc@cont}, #1}
\NewDocumentEnvironment{mistakes}{O{}}{\hsc@parseopts{#1}\hsc@needspace{3}%
  \expandafter\hsc@mistakebox\expandafter[\hsc@tcbopts]}{\endhsc@mistakebox}

\newtcolorbox{hsc@tipbox}[1][]{hsc minor=hsctip, unbreakable, colback=hsctip!8!white,
  colbacktitle=hsctip!26!white, coltitle=hsctiptext,
  title={\hsc@titlebar{\faStar}{HSC exam tip}{}},
  title after break={\hsc@titlebar{\faStar}{HSC exam tip}{}\hsc@cont}, #1}
\NewDocumentEnvironment{examtip}{O{}}{\hsc@parseopts{#1}\hsc@needspace{3}%
