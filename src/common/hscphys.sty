%% ===================================================================
%% 9. Headings, header/footer, contents
%% ===================================================================
\RequirePackage[explicit]{titlesec}
\RequirePackage{titletoc}
\RequirePackage{fancyhdr}
\setcounter{secnumdepth}{1}
\setcounter{tocdepth}{1}

% ---- coloured horizontal rule (the colour marks sit right next to the rule,
%      so a page break can never separate them from it)
\newcommand\hsc@hrule[1]{\par{\color{hscrule}\hrule height #1\relax}}
% ---- "known anchor" helper: links are only made when the target exists
\newcommand\hsc@known[1]{\global\@namedef{hsc@k@#1}{}}
\newcommand\hsc@markknown[1]{\begingroup\protected@edef\hsc@tmp{#1}%
  \immediate\write\@auxout{\string\hsc@known{\hsc@tmp}}\endgroup}
\newcommand\hsc@linkto[2]{\@ifundefined{hsc@k@#1}{#2}{\hyperlink{#1}{#2}}}

% ---- chapter heading
\newcommand\hsc@staricon{\faBookOpen}
\newif\ifhsc@addtoc
\newcommand\hsc@chapnumbox[1]{%
  \tikz[baseline=(n.base)]\node[fill=hscbrand, rounded corners=3.5mm,
    minimum width=19mm, minimum height=19mm, inner sep=0pt, text=white,
    font=\fontsize{32}{32}\selectfont\hsc@heavy](n){#1};}
\newcommand\hsc@chapterhead[1]{%
  \hsc@markknown{chapter.\arabic{chapter}}%
  \noindent
  \begin{minipage}[t]{19mm}\vspace{0pt}\hsc@chapnumbox{\thechapter}\end{minipage}%
  \hspace{6mm}%
  \begin{minipage}[t]{\dimexpr\linewidth-25mm\relax}\vspace{0pt}%
    \RaggedRight
    \leavevmode{\small\hsc@semibold\color{hscmuted}\addfontfeatures{LetterSpace=10}%
      CHAPTER \thechapter\par}%
    \vspace{1pt}%
    \leavevmode{\fontsize{24}{29}\selectfont\bfseries\color{hscbrand}#1\par}%
  \end{minipage}%
  \par\vspace{5mm}\hsc@hrule{0.6pt}}
\newcommand\hsc@chapterheadstar[1]{%
  \ifhsc@addtoc
    \global\hsc@addtocfalse
    \phantomsection\addcontentsline{toc}{chapter}{#1}%
  \fi
  \noindent
  \begin{minipage}[t]{19mm}\vspace{0pt}%
    \hsc@chapnumbox{\fontsize{22}{22}\selectfont\hsc@staricon}\end{minipage}%
  \hspace{6mm}%
  \begin{minipage}[t]{\dimexpr\linewidth-25mm\relax}\vspace{0pt}%
    \RaggedRight
    \vspace{3.2mm}%
    \leavevmode{\fontsize{24}{29}\selectfont\bfseries\color{hscbrand}#1\par}%
  \end{minipage}%
  \par\vspace{5mm}\hsc@hrule{0.6pt}%
  \global\let\hsc@staricon\hsc@defaultstaricon}
\let\hsc@defaultstaricon\hsc@staricon
\titleformat{\chapter}[block]{\normalfont}{}{0pt}{\hsc@chapterhead{#1}}
\titleformat{name=\chapter,numberless}[block]{\normalfont}{}{0pt}{\hsc@chapterheadstar{#1}}
\titlespacing*{\chapter}{0pt}{-28pt}{3mm}

\titleformat{\section}{\normalfont\Large\bfseries\color{hscbrand}}%
  {\textcolor{hscbrandmid}{\thesection}}{0.65em}{#1}
\titleformat{name=\section,numberless}{\normalfont\Large\bfseries\color{hscbrand}}{}{0pt}{#1}
\titlespacing*{\section}{0pt}{20pt plus 4pt minus 2pt}{4pt plus 1pt}
\titleformat{\subsection}{\normalfont\large\bfseries\color{hscbrand}}{}{0pt}{#1}
\titlespacing*{\subsection}{0pt}{14pt plus 3pt minus 2pt}{2pt}
\titleformat{\subsubsection}{\normalfont\normalsize\bfseries\color{hscink}}{}{0pt}{#1}
\titlespacing*{\subsubsection}{0pt}{10pt plus 2pt}{1pt}
% keep a heading together with what follows it
\pretocmd{\section}{\par\Needspace{9\baselineskip}}{}{}
\pretocmd{\subsection}{\par\Needspace{7\baselineskip}}{}{}
\pretocmd{\subsubsection}{\par\Needspace{5\baselineskip}}{}{}

% ---- unnumbered chapter that still appears in the contents
% \unnumberedchapter[<icon>]{<Title>}
\NewDocumentCommand\unnumberedchapter{O{\faBookOpen} m}{%
  \clearpage
  \gdef\hsc@staricon{#1}%
  \global\hsc@addtoctrue
  \chapter*{#2}%
  \markboth{#2}{#2}}

% ---- running header / footer
\newcommand\hsc@headfont{\footnotesize\color{hscmuted}}
\newcommand\hsc@pagenum{{\small\hsc@semibold\color{hscbrand}\thepage}}
\pagestyle{fancy}
\fancyhf{}
\fancyhead[L]{\hsc@headfont Module~\modulenumber: \moduletitle}
\fancyhead[R]{\hsc@headfont\nouppercase{\leftmark}}
\fancyfoot[C]{\hsc@pagenum}
\renewcommand\headrulewidth{0.4pt}
\renewcommand\headrule{{\color{hscrule}%
  \hrule\@height\headrulewidth\@width\headwidth}\vskip-\headrulewidth}
\fancypagestyle{plain}{\fancyhf{}\fancyfoot[C]{\hsc@pagenum}%
  \renewcommand\headrulewidth{0pt}}
\renewcommand\chaptermark[1]{\markboth{Chapter \thechapter: #1}{}}
\renewcommand\sectionmark[1]{}

% ---- table of contents
\renewcommand\contentsname{Contents}
\newcommand\hsc@tocnum[1]{\tikz[baseline=(n.base)]\node[fill=hscbrand,
  rounded corners=1.1mm, minimum width=1.6em, minimum height=1.6em, inner sep=0pt,
  text=white, font=\small\bfseries](n){#1};}
\titlecontents{chapter}[2.6em]
  {\addvspace{9pt}\normalfont\bfseries\color{hscbrand}}
  {\hspace*{-2.6em}\makebox[2.6em][l]{\hsc@tocnum{\thecontentslabel}}}{}{\hfill\contentspage}
\titlecontents{section}[5.4em]
  {\addvspace{0pt}\normalfont\color{hscink}}
  {\contentslabel{2.8em}}{}%
  {\titlerule*[0.75em]{\textcolor{hscrule}{.}}\contentspage}
\let\hsc@origtoc\tableofcontents
\renewcommand\tableofcontents{{\gdef\hsc@staricon{\faListUl}%
  \hypersetup{linkcolor=hscink}\hsc@origtoc}}

%% ===================================================================
%% 10. Module information (normally set by module_info.tex)
