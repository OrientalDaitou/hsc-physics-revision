\RequirePackage{pgfplots}
\pgfplotsset{compat=1.18}
\tikzset{
  >={Stealth[length=2.6mm, width=1.9mm]},
  every picture/.append style={line cap=round, line join=round},
  force/.style       ={->, line width=1.3pt, color=hscforce},
  velocity/.style    ={->, line width=1.3pt, color=hscvel},
  accel/.style       ={->, line width=1.3pt, color=hscacc},
  displacement/.style={->, line width=0.9pt, color=hscmuted},
  field/.style       ={line width=0.8pt, color=hscfield, midarrow},
  ray/.style         ={line width=1pt, color=hscray, midarrow},
  guide/.style       ={line width=0.5pt, dashed, color=hscmuted!80},
  axisline/.style    ={->, line width=0.6pt, color=hscink},
  object/.style      ={draw=hscink, fill=hscbrand!12, line width=0.8pt},
  ground/.style      ={pattern=north east lines, pattern color=hscmuted!70, draw=none},
  diagramlabel/.style={font=\small, text=hscink},
  midarrow/.style    ={postaction={decorate}, decoration={markings,
      mark=at position 0.55 with {\arrow{Stealth[length=2.2mm, width=1.7mm]}}}},
  concept/.style     ={rounded corners=2mm, draw=hscbrand!55, fill=hscbrand!7,
      line width=0.7pt, align=center, inner sep=2mm, font=\small,
      text width=#1}, concept/.default=32mm,
  link/.style        ={->, line width=0.7pt, color=hscbrand!60},
  linklabel/.style   ={font=\footnotesize, text=hscmuted, fill=white, inner sep=1pt},
}
\pgfplotscreateplotcyclelist{hsc}{%
  {hscseriesA, line width=1pt, mark=*, mark size=1.6pt, solid},
  {hscseriesB, line width=1pt, mark=square*, mark size=1.5pt, dashed},
