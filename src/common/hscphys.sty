  \noindent\hypertarget{pq.\hsc@id}{}%
  \hsc@linkto{pa.\hsc@id}{\textcolor{hscbrand}{\bfseries Question \hsc@id}}%
  \hspace{0.7em}\hsc@chpill{#2}%
  \hfill{\small\hsc@semibold\color{hscmuted}\hsc@marks{#1}}\par\nobreak
  \vspace{1pt}}{\par}

% multiple choice:  \choices{A text}{B text}{C text}{D text}
% Layout is chosen automatically (4 across, 2 x 2, or one per line).
% Force a layout with \choices[4]{..}..., \choices[2]{..}... or \choices[1]{..}...
\newlength\hsc@chw
\newlength\hsc@chmax
\newlength\hsc@cellw
\newcommand\hsc@choicelabel[1]{%
  \tikz[baseline=(L.base)]\node[circle, draw=hscbrand!70, line width=0.6pt,
    inner sep=0pt, minimum size=1.4em, font=\small\bfseries, text=hscbrand](L){#1};}
\newcommand\hsc@labelw{2.1em}
\newcommand\hsc@measure[1]{\settowidth\hsc@chw{#1}%
  \ifdim\hsc@chw>\hsc@chmax\global\hsc@chmax=\hsc@chw\fi}
\newcommand\hsc@choicecell[3]{% width, letter, text
  \begin{minipage}[t]{#1}\RaggedRight\hangindent=\hsc@labelw\hangafter=1
    \noindent\makebox[\hsc@labelw][l]{\hsc@choicelabel{#2}}#3\end{minipage}}
\NewDocumentCommand\choices{O{0} m m m m}{%
  \par\addvspace{2pt}%
  \global\hsc@chmax=0pt
  \hsc@measure{#2}\hsc@measure{#3}\hsc@measure{#4}\hsc@measure{#5}%
  \ifnum#1=0
    \setlength\hsc@cellw{\dimexpr(\linewidth-3em)/4-\hsc@labelw\relax}%
    \ifdim\hsc@chmax<\hsc@cellw \def\hsc@cols{4}\else
      \setlength\hsc@cellw{\dimexpr(\linewidth-1.5em)/2-\hsc@labelw\relax}%
      \ifdim\hsc@chmax<\hsc@cellw \def\hsc@cols{2}\else\def\hsc@cols{1}\fi
    \fi
  \else\def\hsc@cols{#1}\fi
  \ifnum\hsc@cols=4
    \setlength\hsc@cellw{\dimexpr(\linewidth-3em)/4\relax}%
    \noindent\hsc@choicecell{\hsc@cellw}{A}{#2}\hspace{1em}%
    \hsc@choicecell{\hsc@cellw}{B}{#3}\hspace{1em}%
    \hsc@choicecell{\hsc@cellw}{C}{#4}\hspace{1em}%
    \hsc@choicecell{\hsc@cellw}{D}{#5}\par
  \else\ifnum\hsc@cols=2
    \setlength\hsc@cellw{\dimexpr(\linewidth-1.5em)/2\relax}%
    \noindent\hsc@choicecell{\hsc@cellw}{A}{#2}\hspace{1.5em}%
    \hsc@choicecell{\hsc@cellw}{B}{#3}\par\addvspace{3pt}%
    \noindent\hsc@choicecell{\hsc@cellw}{C}{#4}\hspace{1.5em}%
    \hsc@choicecell{\hsc@cellw}{D}{#5}\par
  \else
    \noindent\hsc@choicecell{\linewidth}{A}{#2}\par\addvspace{3pt}%
    \noindent\hsc@choicecell{\linewidth}{B}{#3}\par\addvspace{3pt}%
    \noindent\hsc@choicecell{\linewidth}{C}{#4}\par\addvspace{3pt}%
    \noindent\hsc@choicecell{\linewidth}{D}{#5}\par
  \fi\fi
  \addvspace{2pt}}

% ruled lines for a written answer (useful when the book is printed)
\newcommand\answerlines[1]{\par\begingroup\setlength\parskip{0pt}%
  \@tempcnta=#1\relax
  \loop\ifnum\@tempcnta>0
    \vspace{8mm}\noindent\textcolor{hscrule}{\rule{\linewidth}{0.4pt}}\par
    \advance\@tempcnta\m@ne
  \repeat\endgroup\par}

% answers:
%   \begin{practiceanswers}
%     \begin{practiceans} ... \end{practiceans}     (one per question, in order)
%   \end{practiceanswers}
\NewDocumentEnvironment{practiceanswers}{O{Practice set answers}}{%
