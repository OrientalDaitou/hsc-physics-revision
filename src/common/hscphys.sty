%% hscphys.sty
%% Shared design system for the four "HSC Physics Revision Guide" books
%% (NSW Physics Stage 6 Syllabus (2017), Year 12, Modules 5-8).
%%
%% Compile with XeLaTeX.  Use with:
%%   \documentclass[11pt,a4paper,oneside,openany]{book}
%%   \usepackage{hscphys}
%%   \input{module_info}          % defines \modulenumber and \moduletitle
%%
%% The writers' manual is STYLE_GUIDE.md (same folder).
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{hscphys}[2026/10/22 v1.0 HSC Physics revision guide design system]

\@ifclassloaded{book}{}{%
  \PackageWarningNoLine{hscphys}{hscphys is designed for the book class
    (11pt,a4paper,oneside,openany)}}

%% ===================================================================
%% 1. Core packages
%% ===================================================================
\RequirePackage{etoolbox}
\RequirePackage{xparse}
\RequirePackage[a4paper,
  top=27mm, bottom=27mm, left=30mm, right=30mm,
  headheight=16pt, headsep=8mm, footskip=12mm,
  marginparwidth=24mm, marginparsep=3mm]{geometry}
\RequirePackage{amsmath}
\RequirePackage{fontspec}
\RequirePackage{unicode-math}

%% ===================================================================
%% 2. Fonts
%%    Body: Lato (TeX Live, friendly humanist sans).
%%    Maths: Lete Sans Math (TeX Live; designed to match Lato).
%%    Chinese (glossary only): Hiragino Sans GB -> PingFang SC -> Songti SC
%%    -> FandolHei (always in TeX Live).
%% ===================================================================
\defaultfontfeatures{Ligatures=TeX}
\setmainfont{Lato}[
  Extension      = .ttf,
  UprightFont    = *-Regular,
  ItalicFont     = *-Italic,
  BoldFont       = *-Bold,
  BoldItalicFont = *-BoldItalic,
  FontFace       = {sb}{n}{*-Semibold},
  FontFace       = {sb}{it}{*-SemiboldItalic},
  FontFace       = {eb}{n}{*-Heavy},
  FontFace       = {eb}{it}{*-HeavyItalic}]
\setsansfont{Lato}[
  Extension      = .ttf,
  UprightFont    = *-Regular,
  ItalicFont     = *-Italic,
  BoldFont       = *-Bold,
  BoldItalicFont = *-BoldItalic]
\setmonofont{FiraMono}[
  Extension      = .otf,
  UprightFont    = *-Regular,
  BoldFont       = *-Bold,
  Scale          = MatchLowercase]
\setmathfont{LeteSansMath.otf}
\setmathfont{LeteSansMath-Bold.otf}[version=bold]

\IfFontExistsTF{Hiragino Sans GB}{%
  \newfontfamily\hsc@zhfont{Hiragino Sans GB}[BoldFont={Hiragino Sans GB W6}]}{%
  \IfFontExistsTF{PingFang SC}{%
    \newfontfamily\hsc@zhfont{PingFang SC}}{%
    \IfFontExistsTF{Songti SC}{%
      \newfontfamily\hsc@zhfont{Songti SC}}{%
      \newfontfamily\hsc@zhfont{FandolHei-Regular.otf}[BoldFont=FandolHei-Bold.otf]}}}
%% \zh{...}: Chinese words.  ONLY for the Chinese column of the glossary.
\newcommand\zh[1]{{\hsc@zhfont\XeTeXlinebreaklocale "zh"%
  \XeTeXlinebreakskip=0pt plus 1pt\relax #1}}

\newcommand\hsc@semibold{\fontseries{sb}\selectfont}
\newcommand\hsc@heavy{\fontseries{eb}\selectfont}

