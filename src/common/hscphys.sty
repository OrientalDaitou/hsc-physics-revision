  \leavevmode{\small\color{hscmuted}Answers to the Quick check questions in Chapter #1.\par}%
  \begin{hsc@anslist}}{%
  \end{hsc@anslist}%
  \@ifundefined{hsc@qcount@#1}{}{%
    \ifnum\csname hsc@qcount@#1\endcsname=\value{hscans}\else
      \PackageWarningNoLine{hscphys}{Chapter #1 has
