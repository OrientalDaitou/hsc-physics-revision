\newcounter{hscpq}
\newcounter{hscpa}
\newcommand\hsc@setpqcount[1]{\gdef\hsc@pqcount{#1}}
\newcommand\hsc@marks[1]{#1~\ifnum#1=1 mark\else marks\fi}
\newcommand\hsc@chpill[1]{%
  \if\relax\detokenize{#1}\relax\else
    \hsc@linkto{chapter.#1}{\hsc@pill{hscbrand!9}{hscbrand!85}{Ch~#1}}%
  \fi}
% \begin{practiceq}{<marks>}{<chapter number>} question text \end{practiceq}
\NewDocumentEnvironment{practiceq}{m m}{%
  \par\addvspace{10pt}\Needspace{6\baselineskip}%
  \refstepcounter{hscpq}%
  \edef\hsc@id{\arabic{hscpq}}%
