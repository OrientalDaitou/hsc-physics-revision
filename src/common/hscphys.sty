  \leavevmode{\small\color{hscmuted}Answers are at the back of the book.\par}%
  \begin{hsc@qclist}}{\end{hsc@qclist}\endhsc@qcbox}

% answers:  \begin{chapteranswers}{2}{Uniform circular motion} \item ... \end{chapteranswers}
\newcounter{hscans}
\newcommand\hsc@anslabel{%
  \edef\hsc@id{\hsc@anschap.\arabic{hscans}}%
  \hsc@markknown{qcans.\hsc@id}%
  \hypertarget{qcans.\hsc@id}{}%
  \hsc@linkto{qc.\hsc@id}{\textcolor{hscqc}{\bfseries Q\hsc@id}}}
\newenvironment{hsc@anslist}{%
  \list{}{\setlength\leftmargin{3.3em}\setlength\labelwidth{3em}%
    \setlength\labelsep{0.3em}\setlength\itemsep{6pt}\setlength\parsep{4pt}%
    \setlength\topsep{2pt}\setlength\partopsep{0pt}%
    \renewcommand\makelabel[1]{##1\hfil}}%
  \let\hsc@olditem\item
  \def\item{\stepcounter{hscans}\hsc@olditem[\hsc@anslabel]}}%
