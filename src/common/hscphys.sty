\newcommand\hsc@setcoveraccent{%
  \ifcase\modulenumber\relax
    \colorlet{hsccover}{hscbrand}\or\colorlet{hsccover}{hscbrand}\or
    \colorlet{hsccover}{hscbrand}\or\colorlet{hsccover}{hscbrand}\or
