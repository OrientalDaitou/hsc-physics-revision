  \begin{tabular}{@{\hspace{3mm}}L{\dimexpr\linewidth-23mm\relax}@{\hspace{2mm}}C{16mm}@{\hspace{2mm}}}
  \textcolor{hscmuted}{\footnotesize\bfseries Criteria} &
  \textcolor{hscmuted}{\footnotesize\bfseries Marks}\\\hline}{%
  \end{tabular}\endhsc@critbox}
\newcommand\criterion[2]{#1 & #2\\\hline}

% model answer (full marks) for a written question
\newtcolorbox{hsc@modelbox}[1][]{hsc minor=hscexample,
  title={\hsc@titlebar{\faAward}{Model answer (full marks)}{}},
  title after break={\hsc@titlebar{\faAward}{Model answer}{}\hsc@cont}, #1}
\NewDocumentEnvironment{modelanswer}{O{}}{\hsc@parseopts{#1}\hsc@needspace{4}%
