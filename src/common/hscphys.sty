%% 12c. Worked example
%% ---------------------------------------------------------------
\newcounter{hscwe}[chapter]
\renewcommand\thehscwe{\thechapter.\arabic{hscwe}}
\newtcolorbox{hsc@webox}[3][]{hsc major=hscexample,
  title={\hsc@titlebar{\faIcon{pencil-alt}}{Worked example #2}{#3}},
  title after break={\hsc@titlebar{\faIcon{pencil-alt}}{Worked example #2}{#3}\hsc@cont},
  before upper={\hsc@boxsetup\hsc@infcfalse}, #1}
\NewDocumentEnvironment{workedexample}{O{} m}{\hsc@parseopts{#1}\hsc@needspace{9}%
  \global\hsc@dividerfalse
  \ifhsc@nonumber\def\hsc@wenum{}\else\refstepcounter{hscwe}\edef\hsc@wenum{\thehscwe}\fi
  \expandafter\hsc@webegin\expandafter{\hsc@tcbopts}{#2}}{\endhsc@webox}
\def\hsc@webegin#1#2{\hsc@webox[#1]{\hsc@wenum}{#2}}

\newcommand\hsc@steplabel[1]{\hsc@pill{hscexample!13}{hscexample!80!black}{#1}}
\newcommand\hsc@answerlabel[1]{\hsc@pill{hscexample}{white}{#1}}
\newcommand\hsc@solutiondivider{%
  \ifhsc@divider\else\global\hsc@dividertrue
    \par\addvspace{3pt}%
    \noindent{\color{hscexample!50}\leaders\hbox to 5pt{\hss\rule[0.55ex]{3pt}{0.6pt}\hss}\hfill}%
    \hspace{0.7em}{\footnotesize\hsc@semibold\color{hscexample!85!black}%
      \addfontfeatures{LetterSpace=9}SOLUTION}\hspace{0.7em}%
    {\color{hscexample!50}\leaders\hbox to 5pt{\hss\rule[0.55ex]{3pt}{0.6pt}\hss}\hfill}%
    \par\addvspace{1pt}%
  \fi}
\newcommand\hsc@keepwithprev{}
\newcommand\hsc@step[2]{% label box, content
  \hsc@solutiondivider
  \hsc@keepwithprev
  \begin{list}{}{\setlength\leftmargin{26mm}\setlength\labelwidth{24mm}%
      \setlength\labelsep{2mm}\setlength\itemindent{0pt}\setlength\listparindent{0pt}%
      \setlength\topsep{1pt}\setlength\partopsep{0pt}\setlength\parsep{4pt}%
      \setlength\itemsep{0pt}\renewcommand\makelabel[1]{##1\hfil}}%
  \item[#1]#2%
  \end{list}}
\newcommand\given[1]{\hsc@step{\hsc@steplabel{Given}}{#1}}
\newcommand\find[1]{\hsc@step{\hsc@steplabel{Find}}{#1}}
\newcommand\hsc@stepformula[1]{\hsc@step{\hsc@steplabel{Formula}}{#1}}
\newcommand\substitute[1]{\hsc@step{\hsc@steplabel{Substitute}}{#1}}
% Answer and Check are never separated from the step before them by a page break
\newcommand\hsc@nobreakhere{\par
  \ifinner\ifdim\lastskip>\z@\unskip\fi\unpenalty\ifdim\lastskip>\z@\unskip\fi\fi
  \nobreak\@beginparpenalty\@M}
\newcommand\answer[1]{{\let\hsc@keepwithprev\hsc@nobreakhere
  \hsc@step{\hsc@answerlabel{Answer}}{#1}}}
\newcommand\checkstep[1]{{\let\hsc@keepwithprev\hsc@nobreakhere
  \hsc@step{\hsc@steplabel{Check}}{#1}}}
% \formula: a step inside a worked example; the big formula inside a formula card
\newcommand\formula[1]{\ifhsc@infc\cardformula{#1}\else\hsc@stepformula{#1}\fi}
% highlight the final value: \final{$F_\mathrm{c} = \qty{19}{N}$}
\newcommand\final[1]{\tcbox[on line, enhanced, colback=hscexample!12, colframe=hscexample!55,
  boxrule=0.5pt, arc=2pt, left=3pt, right=3pt, top=1pt, bottom=1pt, boxsep=0pt]{#1}}

