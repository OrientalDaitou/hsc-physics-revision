% "M5T3 Motion in Gravitational Fields" quiz: A4, black and white, centred bold
% Calibri title, "Question N – (source)" headings in Calibri bold, question text
% and options in Times New Roman (HSC paper style), page number bottom right.
% XeLaTeX only. Used by quiz.tex and quiz_answers.tex.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{quiz}

\RequirePackage[a4paper, left=2.4cm, right=2.4cm, top=2.3cm, bottom=2.6cm,
  footskip=1.3cm]{geometry}
\RequirePackage{amsmath}
\RequirePackage{fontspec}
\RequirePackage{unicode-math}
\setmainfont{Times New Roman}
\setmathfont{STIX Two Math}
\IfFontExistsTF{Calibri}{\newfontfamily\headfont{Calibri}}{%
  \IfFileExists{/Applications/Microsoft Word.app/Contents/Resources/DFonts/Calibri.ttf}{%
    \newfontfamily\headfont{Calibri}[Path=/Applications/Microsoft Word.app/Contents/Resources/DFonts/,
      Extension=.ttf, UprightFont=*, BoldFont=*b, ItalicFont=*i, BoldItalicFont=*z]}{%
    \newfontfamily\headfont{Carlito}}}  % Carlito = free font with Calibri's shapes
\linespread{1.08}
\setlength\parindent{0pt}
\hyphenpenalty=10000 \exhyphenpenalty=10000 \emergencystretch=3em
\setlength\parskip{6pt}
\RequirePackage{needspace}
\RequirePackage{array}
\RequirePackage{xcolor}
\RequirePackage{siunitx}
\sisetup{exponent-product=\times, per-mode=power, inter-unit-product=\,,
  group-separator={\,}, group-minimum-digits=5, separate-uncertainty=true}
\DeclareSIUnit\yr{yr}
\RequirePackage{tikz}
\usetikzlibrary{arrows.meta, calc, shadings}
\RequirePackage{pgfplots}
\pgfplotsset{compat=1.18}
\RequirePackage{enumitem}
\setlist[itemize]{topsep=2pt, itemsep=2pt, parsep=0pt, leftmargin=1.6em}
\RequirePackage{fancyhdr}
\pagestyle{fancy}
\fancyhf{}
\fancyfoot[R]{{\headfont\fontsize{11}{13}\selectfont\thepage}}
\renewcommand\headrulewidth{0pt}
\fancypagestyle{plain}{\fancyhf{}\fancyfoot[R]{{\headfont\fontsize{11}{13}\selectfont\thepage}}%
  \renewcommand\headrulewidth{0pt}}
\RequirePackage[hidelinks]{hyperref}

% ---- black-and-white drawing styles (same names as the revision books)
\colorlet{hscink}{black}\colorlet{hscmuted}{black}\colorlet{hscrule}{black!45}
\colorlet{hscseriesA}{black}\colorlet{hscseriesB}{black}
\colorlet{hscacc}{black!45}\colorlet{hscbrand}{black!60}\colorlet{hscforce}{black}
\tikzset{
  >={Stealth[length=2.4mm, width=1.8mm]},
  every picture/.append style={line cap=round, line join=round},
  force/.style       ={->, line width=0.9pt, color=black},
  displacement/.style={->, line width=0.7pt, color=black},
  guide/.style       ={line width=0.5pt, dash pattern=on 2pt off 2pt, color=black!70},
  axisline/.style    ={->, line width=0.7pt, color=black},
  object/.style      ={draw=black, fill=white, line width=0.7pt},
}

% ---- title:  \quiztitle{line 1}{line 2}
\newcommand\quiztitle[2]{%
  \begin{center}
    {\headfont\bfseries\fontsize{16}{21}\selectfont #1\\ #2\par}
  \end{center}\vspace{2pt}}

% ---- one question:  \begin{quizq}{} ... \end{quizq}
\newcounter{qn}
\NewDocumentEnvironment{quizq}{m}{%
  \par\refstepcounter{qn}%
  \hypertarget{q.\arabic{qn}}{}%
  \noindent{\headfont\bfseries\fontsize{11}{14}\selectfont
    \hyperlink{a.\arabic{qn}}{Question \arabic{qn}}}\par\nobreak
  \vspace{2pt}}{\par\vspace{9mm}}

% ---- options, one per line:  \opts{..}{..}{..}{..}
\newcommand\optline[2]{\par\noindent\hangindent=12mm\hangafter=1
  \makebox[12mm][l]{#1}#2\par\vspace{3pt}}
\newcommand\opts[4]{\par\vspace{2pt}%
  \optline{A.}{#1}\optline{B.}{#2}\optline{C.}{#3}\optline{D.}{#4}}
% ---- options that are pictures, 2 x 2:  \gridopts{..}{..}{..}{..}
\newcommand\gridcell[2]{\begin{minipage}[t]{0.48\linewidth}%
  \makebox[10mm][l]{#1}\begin{minipage}[t]{\dimexpr\linewidth-12mm\relax}\vspace{0pt}#2%
  \end{minipage}\end{minipage}}
\newcommand\gridopts[4]{\par\vspace{4pt}\noindent
  \gridcell{A.}{#1}\hfill\gridcell{B.}{#2}\par\vspace{8mm}\noindent
  \gridcell{C.}{#3}\hfill\gridcell{D.}{#4}\par}

% ---- answers file
\newcounter{an}
\NewDocumentEnvironment{practiceanswers}{o}{}{}
\NewDocumentEnvironment{practiceans}{}{\par\refstepcounter{an}}{\par\vspace{5mm}}
\newcommand\correct[1]{%
  \hypertarget{a.\arabic{an}}{}%
  \noindent{\headfont\bfseries\fontsize{11}{14}\selectfont
    \hyperlink{q.\arabic{an}}{Question \arabic{an} – Answer: #1}}\par\nobreak\vspace{1pt}}
\newcommand\xmark{{\bfseries\texttimes}}
\endinput
